#!/usr/bin/env bash
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
staged="$(git diff --cached --name-only)"
areas=()

if grep -qE '^(cli|scripts|\.githooks)/' <<<"$staged"; then
  areas+=(rust)
fi

if grep -q '^dashboard/' <<<"$staged"; then
  [ -x "$root/dashboard/node_modules/.bin/eslint" ] || { echo "pre-commit: run 'npm ci' in dashboard/" >&2; exit 1; }
  areas+=(dashboard)
fi

if grep -q '^npm/' <<<"$staged"; then
  areas+=(npm)
fi

workflows="$(grep -E '^\.github/workflows/.+\.ya?ml$' <<<"$staged" | grep -v '^\.github/workflows/release\.yml$' || true)"
if [ -n "$workflows" ]; then
  command -v actionlint >/dev/null || { echo "pre-commit: install actionlint (brew install actionlint) to check .github/workflows" >&2; exit 1; }
  (cd "$root" && actionlint $workflows)
fi

if [ "${#areas[@]}" -gt 0 ]; then
  "$root/scripts/gauntlet.sh" "${areas[@]}"
fi
