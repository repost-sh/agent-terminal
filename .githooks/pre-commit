#!/usr/bin/env bash
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
staged="$(git diff --cached --name-only)"
areas=()

if grep -qE '^((cli|scripts|\.githooks|skill-data|skills)/|GAUNTLET\.md$|rust-toolchain\.toml$)' <<<"$staged"; then
  areas+=(rust)
fi

if grep -q '^dashboard/' <<<"$staged"; then
  [ -x "$root/dashboard/node_modules/.bin/eslint" ] || { echo "pre-commit: run 'npm ci' in dashboard/" >&2; exit 1; }
  areas+=(dashboard)
fi

if grep -q '^npm/' <<<"$staged"; then
  areas+=(npm)
fi

if grep -qE '^(cli|dashboard|scripts|\.githooks)/' <<<"$staged"; then
  [ -x "$root/dashboard/node_modules/.bin/jscpd" ] || { echo "pre-commit: run 'npm ci' in dashboard/" >&2; exit 1; }
  areas+=(duplication)
fi

if grep -qE '^\.github/(workflows|actions)/' <<<"$staged"; then
  areas+=(workflows)
fi

if [ "${#areas[@]}" -gt 0 ]; then
  "$root/scripts/gauntlet.sh" "${areas[@]}"
fi
