// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`restarting a running program asks first in an alert that only its buttons close 1`] = `"<div role="alertdialog" aria-modal="true" aria-labelledby="_r_a_-title" aria-describedby="_r_a_-desc" tabindex="-1" class="dialog-content fixed top-1/2 left-1/2 z-50 grid max-h-[calc(100dvh-2rem)] w-full -translate-x-1/2 -translate-y-1/2 gap-4 overflow-y-auto rounded-xl bg-popover p-4 text-sm text-popover-foreground ring-1 ring-foreground/10 outline-none" style="max-width: min(calc(100vw - 2rem), 24rem);"><div class="flex flex-col gap-2 pr-8"><h2 id="_r_a_-title" class="font-heading text-base leading-none font-medium [overflow-wrap:anywhere]">Restart vim?</h2><p id="_r_a_-desc" class="text-sm text-muted-foreground">work t1 is killed and started again with the same command, size and working directory.</p></div><div class="-mx-4 -mb-4 flex flex-col-reverse gap-2 rounded-b-xl border-t bg-muted/50 p-4 sm:flex-row sm:justify-end"><button type="button" data-autofocus="true" class="group/button inline-flex shrink-0 items-center justify-center border border-transparent bg-clip-padding font-medium whitespace-nowrap transition-all outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 active:not-aria-[haspopup]:translate-y-px disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 hover:bg-muted hover:text-foreground aria-expanded:bg-muted aria-expanded:text-foreground dark:hover:bg-muted/50 h-7 gap-1 rounded-[min(var(--radius-md),12px)] px-2.5 text-[0.8rem] [&amp;_svg]:size-3.5">Cancel</button><button type="button" class="group/button inline-flex shrink-0 items-center justify-center border border-transparent bg-clip-padding font-medium whitespace-nowrap transition-all outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 active:not-aria-[haspopup]:translate-y-px disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 bg-primary text-primary-foreground hover:bg-primary/80 h-7 gap-1 rounded-[min(var(--radius-md),12px)] px-2.5 text-[0.8rem] [&amp;_svg]:size-3.5">Restart</button></div></div>"`;
